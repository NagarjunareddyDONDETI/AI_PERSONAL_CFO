# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# ---- LLM providers ----
# NEVER put real keys in this file — it is a template and is NOT gitignored.
# Copy it to `.env` (which is ignored) and fill the values in there.
#
# Failover order, skipping any provider without a key:
#   1. Groq  2. GitHub Models  3. OpenRouter  4. Ollama (local)  5. Gemini
# The chain advances on quota, rate-limit, server and timeout errors. The order
# is defined by _PROVIDER_ORDER in llm/router.py, which is authoritative.
GROQ_API_KEY=
GITHUB_TOKEN=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=

# auto = walk the chain above. Forcing one provider still keeps the others as
# fallback, so a forced choice is not a single point of failure:
#   groq|github|openrouter|ollama|gemini
DEFAULT_PROVIDER=auto

# ---- Optional model overrides ----
# Providers retire models regularly. If a provider starts returning 404
# "model_not_found", list its models and pick a current one:
#   Groq       GET https://api.groq.com/openai/v1/models
#   OpenRouter GET https://openrouter.ai/api/v1/models   (ids ending in ":free")
#   Gemini     GET https://generativelanguage.googleapis.com/v1beta/models?key=...
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-120b
GITHUB_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OLLAMA_MODEL=llama3.2

# ---- Cache ----
LLM_CACHE_TTL=900
# Leave REDIS_URL empty to use the in-memory cache; set it to enable Redis.
REDIS_URL=

# ---- Voice assistant (Phase: Voice) ----
# STT provider priority (comma-separated, first available wins, then failover):
#   groq_whisper (needs GROQ_API_KEY) | whisper_local (offline, needs openai-whisper)
STT_PROVIDER=groq_whisper,whisper_local
# TTS provider priority: gtts (online) | edge_tts (needs `pip install edge-tts`)
TTS_PROVIDER=gtts,edge_tts

# Feature toggles
ENABLE_STREAMING=true
ENABLE_MEMORY=true
ENABLE_RAG=true
ENABLE_OFFLINE_MODE=true
VOICE_AUTO_RETRY=true

# STT tuning
WHISPER_MODEL=small
WHISPER_LANG=en
GROQ_STT_MODEL=whisper-large-v3-turbo
# Retry another STT provider below this confidence (0..1)
VOICE_STT_MIN_CONFIDENCE=0.75

# TTS tuning
VOICE_TTS_LANG=en
EDGE_TTS_VOICE=en-US-AriaNeural

# ---- Authentication (required in production) ----
# Secret used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank the server generates a random secret at startup, which means
# every restart signs everyone out and tokens break across multiple workers.
# Changing this value invalidates all existing sessions.
AUTH_SECRET=

# ---- Database ----
# Where the SQLite file lives. Leave both blank to use backend/db/cfo.db.
# On a host with an ephemeral filesystem (Render, Heroku, most containers) point
# one of these at a mounted persistent volume or every deploy wipes the data.
#   CFO_DB_PATH=/var/data/cfo.db      # full path to the database file
#   CFO_DATA_DIR=/var/data            # directory to place cfo.db in
CFO_DB_PATH=
CFO_DATA_DIR=

# ---- Deployment ----
# Comma-separated list of allowed browser origins in production, e.g.
# ALLOWED_ORIGINS=https://cfo.example.com,https://www.cfo.example.com
# Leave as "*" for local development (credentials are disabled with "*").
# Set this to your real frontend URL in production — "*" lets any site call the
# API with a token it has obtained.
ALLOWED_ORIGINS=*

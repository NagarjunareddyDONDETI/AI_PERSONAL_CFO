# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# ---- LLM providers ----
# NEVER put real keys in this file — it is a template and is NOT gitignored.
# Copy it to `.env` (which is ignored) and fill the values in there.
#
# Failover order, skipping any provider without a key:
#   1. Groq  2. GitHub Models  3. OpenRouter  4. Ollama (local)  5. Gemini
# The chain advances on quota, rate-limit, server and timeout errors. The order
# is defined by _PROVIDER_ORDER in llm/router.py, which is authoritative.
GROQ_API_KEY=
GITHUB_TOKEN=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=

# auto = walk the chain above. Forcing one provider still keeps the others as
# fallback, so a forced choice is not a single point of failure:
#   groq|github|openrouter|ollama|gemini
DEFAULT_PROVIDER=auto

# ---- Optional model overrides ----
# Providers retire models regularly. If a provider starts returning 404
# "model_not_found", list its models and pick a current one:
#   Groq       GET https://api.groq.com/openai/v1/models
#   OpenRouter GET https://openrouter.ai/api/v1/models   (ids ending in ":free")
#   Gemini     GET https://generativelanguage.googleapis.com/v1beta/models?key=...
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-120b
GITHUB_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OLLAMA_MODEL=llama3.2

# ---- Cache & Memory Management ----
LLM_CACHE_TTL=900
MAX_LLM_CACHE_SIZE=512
MAX_WORKFLOW_CACHE_SIZE=128
MAX_UPLOAD_SIZE_MB=15
MAX_CONCURRENT_ANALYSES=2
MAX_PDF_PAGES=50
MAX_TRANSACTIONS_LIMIT=25000
# Leave REDIS_URL empty to use the in-memory cache; set it to enable Redis.
REDIS_URL=

# ---- Voice assistant (Phase: Voice) ----
# STT provider priority (comma-separated, first available wins, then failover):
#   voicebox       local Voicebox app (see VOICEBOX_* below)
#   groq_whisper   cloud, needs GROQ_API_KEY
#   faster_whisper local, offline (pip install faster-whisper)
#   whisper_local  local, needs openai-whisper (pulls torch; prefer faster_whisper)
STT_PROVIDER=voicebox,groq_whisper,faster_whisper,whisper_local
# TTS provider priority for the dashboard:
#   voicebox (local) | gtts (online) | edge_tts (online, pip install edge-tts)
# Voicebox is skipped automatically while the Voicebox app is closed.
TTS_PROVIDER=voicebox,gtts,edge_tts

# Feature toggles
ENABLE_STREAMING=true
ENABLE_MEMORY=true
ENABLE_RAG=true
ENABLE_OFFLINE_MODE=true
VOICE_AUTO_RETRY=true

# STT tuning
WHISPER_MODEL=small
WHISPER_LANG=en
GROQ_STT_MODEL=whisper-large-v3-turbo
# Retry another STT provider below this confidence (0..1)
VOICE_STT_MIN_CONFIDENCE=0.75

# TTS tuning
VOICE_TTS_LANG=en
EDGE_TTS_VOICE=en-US-AriaNeural

# faster-whisper placement. auto = CUDA if it works, else CPU. int8 keeps the
# "small" model around 500 MB. GPU needs NVIDIA's cuBLAS/cuDNN 12 DLLs on PATH
# (see docs/FINZO_VOICE.md); without them it falls back to CPU automatically.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# ---- Voicebox (local voice studio, https://github.com/jamiepine/voicebox) ----
# Finzo uses Voicebox's REST API for speech-to-text and text-to-speech. If the
# app is closed, Finzo falls back to the next provider in the lists above.
VOICEBOX_ENABLED=true
VOICEBOX_BASE_URL=http://127.0.0.1:17493
# Informational. Finzo talks REST; MCP is for agents calling voicebox.speak.
VOICEBOX_MCP_URL=
# Name OR id of the voice profile Finzo speaks with, e.g. "Finzo".
# Required for Voicebox speech output; create the profile in the Voicebox app.
VOICEBOX_VOICE_ID=
# Optional engine override: qwen | qwen_custom_voice | luxtts | chatterbox |
# chatterbox_turbo | tada | kokoro. Empty = the profile's default engine.
VOICEBOX_ENGINE=
VOICEBOX_LANGUAGE=en
# Whisper size Voicebox uses for /transcribe: base|small|medium|large|turbo.
VOICEBOX_STT_MODEL=
# Delivery hint, honoured by Qwen engines only.
VOICEBOX_INSTRUCT=Speak calmly and clearly, like a professional financial advisor.
VOICEBOX_TIMEOUT=60
VOICEBOX_HEALTH_TTL=15

# ---- Hands-free service (python -m voice.main / start_finzo_voice.bat) ----
VOICE_ENABLED=true
# Whose finances the hands-free service answers about: your login email.
# Required when more than one account exists.
FINZO_VOICE_USER_EMAIL=
WAKE_WORD_ENABLED=true
# "hey finzo" also activates on a bare "finzo".
WAKE_WORD=hey finzo
# Small model used only to spot the wake phrase; keeps idle CPU low.
WAKE_WHISPER_MODEL=tiny.en
WAKE_PROBE_SECONDS=2.5
AUDIO_SAMPLE_RATE=16000
MAX_RECORD_SECONDS=20
SILENCE_TIMEOUT=1.2
# 0 (lenient) .. 3 (strict). Raise it in a noisy room.
VAD_AGGRESSIVENESS=2
# Seconds to wait for your question after Finzo says "Yes?".
LISTEN_TIMEOUT=8
# After an answer, a follow-up needs no wake word for this long. 0 disables.
FOLLOWUP_SECONDS=6
# Microphone index or name fragment; empty = Windows default.
# List them with: python -m voice.main --list-devices
MIC_DEVICE=
# Local engines only by default, so answer text never goes to a cloud TTS.
#   voicebox | pyttsx3 (Windows SAPI, offline) | none
FINZO_DAEMON_TTS=voicebox,pyttsx3
FINZO_DAEMON_STT=faster_whisper,voicebox
# Windows SAPI voice (name fragment) and speed in words per minute.
PYTTSX3_VOICE=David
PYTTSX3_RATE=172
# Where status and log files go; empty = backend/.finzo
FINZO_VOICE_STATE_DIR=
# Logs what the wake detector heard. Leave off: it writes speech to the log.
VOICE_DEBUG=false

# ---- Authentication (required in production) ----
# Secret used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank the server generates a random secret at startup, which means
# every restart signs everyone out and tokens break across multiple workers.
# Changing this value invalidates all existing sessions.
AUTH_SECRET=

# ---- Database ----
# Where the SQLite file lives. Leave both blank to use backend/db/cfo.db.
# On a host with an ephemeral filesystem (Render, Heroku, most containers) point
# one of these at a mounted persistent volume or every deploy wipes the data.
#   CFO_DB_PATH=/var/data/cfo.db      # full path to the database file
#   CFO_DATA_DIR=/var/data            # directory to place cfo.db in
CFO_DB_PATH=
CFO_DATA_DIR=

# ---- Deployment ----
# Comma-separated list of allowed browser origins in production, e.g.
# ALLOWED_ORIGINS=https://cfo.example.com,https://www.cfo.example.com
# Leave as "*" for local development (credentials are disabled with "*").
# Set this to your real frontend URL in production — "*" lets any site call the
# API with a token it has obtained.
ALLOWED_ORIGINS=*
